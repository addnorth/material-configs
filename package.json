{
  "name": "material-configs",
  "version": "1.0.0",
  "description": "Material configs system for generating slicer configs",
  "type": "module",
  "main": "dist/scripts/build.js",
  "scripts": {
    "add-material": "tsc && node dist/scripts/add-material.js",
    "build": "tsc && node dist/scripts/build.js",
    "build:watch": "chokidar \"build/**\" \"scripts/**\" \"materials/**\" \"config/**\" \"templates/**\" -c \"npm run build\" --initial",
    "validate": "tsc && node dist/scripts/build.js --validate-only",
    "validate:watch": "chokidar \"materials/**\" \"config/**\" -c \"npm run validate\" --initial",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "3d-printing",
    "slicer",
    "prusaslicer",
    "bambuslicer",
    "material-config"
  ],
  "author": "addnorth",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "ini": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^6.0.2",
    "@types/ini": "^1.3.4",
    "@types/node": "^24.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.2"
  }
}
